{
  "name": "mactions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "typecheck": "npm --prefix web run typecheck",
    "package": "node --experimental-strip-types scripts/package.ts",
    "smoke": "node --experimental-strip-types scripts/native-smoke.ts",
    "memory": "node --experimental-strip-types scripts/measure-memory.ts",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "lint": "npm --prefix web run lint",
    "format": "npm --prefix web run format && cargo fmt --all",
    "format:check": "npm --prefix web run format:check && cargo fmt --all -- --check",
    "check": "npm --prefix web run check",
    "check:all": "npm --prefix web run check:all",
    "test": "npm --prefix web test"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.4.0"
  }
}
