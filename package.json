{
  "name": "mactions",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:rustup": "PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:/usr/local/opt/rustup/bin:$PATH\" npm run dev",
    "dev:web": "vite web --host 127.0.0.1",
    "build": "npm run check && npm run build:assets",
    "build:assets": "vite build web",
    "test": "vitest run --root web",
    "lint": "eslint --max-warnings=0 . && node --test lint/**/*.test.ts",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc -p . && tsc -p web",
    "format": "npm run lint:fix && prettier --write --cache . && PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:/usr/local/opt/rustup/bin:$PATH\" cargo fmt --all",
    "format:check": "prettier --check . && PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/rustup/bin:/usr/local/opt/rustup/bin:$PATH\" cargo fmt --all -- --check",
    "check": "npm run lint && prettier --check . && npm run typecheck",
    "check:all": "npm run build && npm test && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo test --locked && npm run test:install && npm run test:homebrew",
    "package": "node scripts/package.ts",
    "homebrew": "node scripts/homebrew.ts",
    "homebrew:source": "node scripts/homebrew-source.ts",
    "test:install": "node scripts/install-smoke.ts",
    "test:homebrew": "node --test scripts/homebrew.test.ts scripts/homebrew-source.test.ts",
    "test:manager": "node scripts/manager-smoke.ts",
    "smoke": "node scripts/native-smoke.ts",
    "memory": "node scripts/measure-memory.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write",
    "*.rs": "rustfmt --edition 2021 --config skip_children=true"
  },
  "dependencies": {
    "@date-fns/utc": "2.1.1",
    "@tanstack/react-query": "5.103.2",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-select": "^5.10.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/rule-tester": "8.71.0",
    "@typescript-eslint/utils": "8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-x": "5.23.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup-plugin-license": "3.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
