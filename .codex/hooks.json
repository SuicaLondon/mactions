{
  "description": "Format and lint repository code after Codex edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix \"$(git rev-parse --show-toplevel)\" run --silent format >&2 || exit 2",
            "timeout": 120,
            "statusMessage": "Formatting repository code"
          }
        ]
      }
    ]
  }
}
