{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix \"$CLAUDE_PROJECT_DIR\" run --silent format >&2 || exit 2",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
